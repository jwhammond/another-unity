{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["engine/src", "tools/*/src", "games/*/hooks", "vitest.config.ts"],
  "exclude": ["tools/gate", "engine/src/view", "engine/src/audio", "engine/src/ui", "engine/src/dev", "engine/src/web"]
}
